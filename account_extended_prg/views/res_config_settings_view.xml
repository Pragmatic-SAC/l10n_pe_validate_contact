<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <record id="res_config_settings_view_form_detraccion_threshold" model="ir.ui.view">
      <field name="name">res.config.settings.view.form.detraccion.threshold</field>
      <field name="model">res.config.settings</field>
      <field name="inherit_id" ref="account.res_config_settings_view_form"/>
      <field name="arch" type="xml">
        <xpath expr="//div[@id='monitor_product_margins']" position="after">

            <div class="o_setting_right_pane">
              <label for="detraccion_threshold_amount"/>
              <div class="text-muted">
                Umbral (moneda de la compañía) para mostrar una alerta informativa de detracción al confirmar facturas de cliente.
              </div>
            </div>
            <div class="o_setting_box">
              <div class="o_setting_left_pane">
                <field name="detraccion_threshold_amount"/>
              </div>
            </div>
        </xpath>
      </field>
    </record>
  </data>
</odoo>
